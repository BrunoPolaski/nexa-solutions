# Copie este arquivo para `.env` e ajuste os valores antes de subir o ambiente:
#   cp .env.example .env
# O arquivo `.env` é ignorado pelo Git e NUNCA deve ser versionado.

# ----- APLICAÇÃO -----
# Gere uma chave própria com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ----- BANCO DE DADOS (PostgreSQL) -----
POSTGRES_DB=nexa_chamados
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
